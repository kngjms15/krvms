generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model VolunteerApplicant {
  applicantId                  String   @id @default(uuid())
  createdAt                    DateTime @default(now())
  firstName                    String   @db.VarChar(50)
  lastName                     String   @db.VarChar(50)
  dob                          DateTime
  address                      String   @db.VarChar(60)
  city                         String   @db.VarChar(50)
  province                     String   @db.VarChar(2)
  postalCode                   String   @db.VarChar(7)
  chapter                      String   @db.VarChar(50)
  primaryPhone                 String   @db.VarChar(15)
  secondaryPhone               String?
  email                        String   @db.VarChar(50)
  employer                     String   @db.VarChar(50)
  conviction                   Boolean
  bondable                     Boolean
  medicalCondition             Boolean
  medicalConditionDetails      String?  @db.VarChar(500)
  emergencyContactName         String   @db.VarChar(50)
  emergencyContactRelationship String   @db.VarChar(50)
  emergencyContactPhone        String   @db.VarChar(15)
  volunteerExperienceDetails   String?  @db.VarChar(500)
  interviewStatus              String   @db.VarChar(20)
}

model Volunteer {
  volunteerId                  String   @id @default(uuid())
  createdAt                    DateTime @default(now())
  firstName                    String   @db.VarChar(50)
  lastName                     String   @db.VarChar(50)
  role                         String   @db.VarChar(20)
  dob                          DateTime
  address                      String   @db.VarChar(60)
  city                         String   @db.VarChar(50)
  province                     String   @db.VarChar(2)
  postalCode                   String   @db.VarChar(7)
  chapter                      String   @db.VarChar(20)
  primaryPhone                 String   @db.VarChar(15)
  secondaryPhone               String?
  email                        String   @db.VarChar(50)
  employer                     String   @db.VarChar(50)
  conviction                   Boolean
  bondable                     Boolean
  medicalCondition             Boolean
  medicalConditionDetails      String?  @db.VarChar(500)
  emergencyContactName         String   @db.VarChar(50)
  emergencyContactRelationship String   @db.VarChar(50)
  emergencyContactPhone        String   @db.VarChar(15)
  volunteerExperienceDetails   String?  @db.VarChar(500)
  interviewStatus              String   @db.VarChar(20)
  status                       String   @db.VarChar(20)
}

model Event {
  eventId              String   @id @default(uuid())
  chapterId            String   @db.VarChar(255)
  chapter              Chapter  @relation(fields: [chapterId], references: [chapterId])
  location             String   @db.VarChar(255)
  date                 DateTime
  startTime            String   @db.VarChar(10)
  endTime              String   @db.VarChar(10)
  volunteersNeeded     Int
  volunteersRegistered Int
}

model Chapter {
  chapterId         String  @id @default(uuid())
  chapterName       String  @db.VarChar(255)
  chapterAddress    String  @db.VarChar(255)
  chapterCity       String  @db.VarChar(255)
  chapterProvince   String  @db.VarChar(255)
  chapterPostalCode String  @db.VarChar(10)
  events            Event[]
}
