generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VolunteerApplicant {
  applicantId                  Int      @id @default(autoincrement())
  createdAt                    DateTime @default(now())
  firstName                    String   @db.VarChar(50)
  lastName                     String   @db.VarChar(50)
  dob                          DateTime
  address                      String   @db.VarChar(50)
  city                         String   @db.VarChar(50)
  province                     String   @db.VarChar(2)
  postalCode                   String   @db.VarChar(6)
  chapter                      String   @db.VarChar(20)
  primaryPhone                 String   @db.VarChar(10)
  secondaryPhone               String?
  email                        String   @db.VarChar(50)
  employer                     String   @db.VarChar(50)
  conviction                   Boolean
  bondable                     Boolean
  medicalCondition             Boolean
  medicalConditionDetails      String?  @db.VarChar(500)
  emergencyContactName         String   @db.VarChar(50)
  emergencyContactRelationship String   @db.VarChar(50)
  emergencyContactPhone        String   @db.VarChar(10)
  volunteerExperienceDetails   String?  @db.VarChar(500)
  interviewStatus              String   @db.VarChar(20)
}
